# Copy to .env values you want, then run with:  node --env-file=.env src/server.js
PORT=4000

# Seconds between courier stages. 30 = demo speed. In production these are hours and days.
STEP_DELAY_SEC=30

# false = no timers, use the demo "advance" button only
AUTO_SIMULATE=true

# Auto-cancel orders the artisan has not packed within this many minutes (2880 = 48 hours).
# Set to 2 for a live demo of the edge case. 0 disables it.
AUTO_CANCEL_MINUTES=2880
AUTO_CANCEL_CHECK_SEC=60

# Platform margin on goods (BuyMe), in percent
PLATFORM_FEE_PCT=10
